rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Profiles
    match /profiles/{userId} {
      allow read, write: if true;
    }

    // Establishments - read, create, update, delete enabled for management
    match /establishments/{establishmentId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Pix Keys - full CRUD enabled
    match /pix_keys/{keyId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Payment Links - full CRUD enabled
    match /payment_links/{linkId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // NFC Tags - full CRUD enabled
    match /nfc_tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Page Visits (Analytics)
    match /page_visits/{visitId} {
      allow create, read: if true;
      allow update, delete: if false;
    }
  }
}
